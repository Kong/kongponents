{
  "extends": "./tsconfig.json",
  /**
   * Declaration emit only — `pnpm typecheck` uses the root config.
   *
   * `--emitDeclarationOnly` emits a `.d.ts` for every file in the program, so the test
   * entries below matter even though no bundled code imports a test. `test` especially:
   * it lives outside `src`, so including it moves the inferred root to the repo root and
   * declarations land in `dist/types/src/` instead of `dist/types/`, breaking the `types`
   * entry point.
   */
  "exclude": [
    "src/**/*.cy.ts",
    "src/**/*.spec.ts",
    "test",
    "src/App.vue",
    "src/main.ts",
    "sandbox",
    "node_modules",
    "dist",
  ],
}
